#!/bin/bash
# mydistro-winapps-setup — guided setup for running Windows apps (Photoshop,
# Office, etc.) as seamless windows on the Linux desktop.
#
# Wraps the upstream WinApps project (github.com/winapps-org/winapps):
#   1. checks the machine can run a Windows VM (KVM, RAM, disk)
#   2. asks for Windows version, account and resources
#   3. writes ~/.config/winapps/winapps.conf and compose.yaml
#   4. starts Windows in a Podman container and shows the install progress
#   5. waits until Windows is ready, then runs WinApps' own installer
#
# The user still needs their own Windows license and app licenses.
# Run as your normal user, not root.

set -euo pipefail

APP="MyDistro Windows Apps"
REPO_URL="https://github.com/winapps-org/winapps.git"
REPO_DIR="$HOME/.local/share/mydistro/winapps"
CONF_DIR="$HOME/.config/winapps"
CONF="$CONF_DIR/winapps.conf"
COMPOSE="$CONF_DIR/compose.yaml"
VIEWER="http://127.0.0.1:8006"

title() { dialog --backtitle "$APP" "$@"; }
die()   { title --title "Problem" --msgbox "$1" 10 64; clear; exit 1; }

[[ $EUID -eq 0 ]] && { echo "Run this as your normal user, not root."; exit 1; }
command -v dialog >/dev/null || { echo "Missing 'dialog'. Install mydistro-winapps."; exit 1; }

# ---- 1. Hardware checks -----------------------------------------------------
[[ -e /dev/kvm ]] || die "Hardware virtualization (KVM) isn't available.\n\nEnable Intel VT-x or AMD-V (SVM) in your BIOS/UEFI settings, then run this again."

if [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
  title --title "Permission needed" --yesno "Your account needs to be in the 'kvm' group to run Windows.\n\nAdd it now? (asks for your password; you'll need to log out and back in, then rerun this.)" 11 64 \
    && { clear; sudo usermod -aG kvm "$USER"; title --msgbox "Done. Log out, log back in, and run Windows Apps Setup again." 8 60; clear; exit 0; } \
    || { clear; exit 1; }
fi

RAM_GB=$(awk '/MemTotal/ {printf "%d", $2/1024/1024}' /proc/meminfo)
FREE_GB=$(df -BG --output=avail "$HOME" | tail -1 | tr -dc '0-9')
CORES=$(nproc)

if (( RAM_GB < 8 )); then
  title --title "Low memory" --yesno "This PC has ${RAM_GB} GB RAM. Windows plus Linux really wants 16 GB.\nPhotoshop will be slow. Continue anyway?" 9 64 || { clear; exit 1; }
fi
(( FREE_GB >= 70 )) || die "Only ${FREE_GB} GB free in your home folder. Windows needs about 70 GB, plus space for your apps."

# ---- 2. Choices -------------------------------------------------------------
WIN_VERSION=$(title --title "Windows version" --menu "Which Windows should be installed?\n(Downloaded from Microsoft; activate it with your own license.)" 14 64 3 \
  11  "Windows 11 Pro (recommended)" \
  10  "Windows 10 Pro (lighter)" \
  ltsc10 "Windows 10 LTSC (leanest)" 3>&1 1>&2 2>&3) || { clear; exit 1; }

WIN_USER=$(title --title "Windows account" --inputbox "Username for the Windows account:" 9 60 "$USER" 3>&1 1>&2 2>&3) || { clear; exit 1; }
WIN_PASS=$(title --title "Windows account" --insecure --passwordbox "Password for the Windows account (needed for the connection):" 9 60 3>&1 1>&2 2>&3) || { clear; exit 1; }
[[ -n "$WIN_PASS" ]] || die "A password is required; WinApps connects with it."

DEFAULT_RAM=$(( RAM_GB >= 16 ? 8 : 4 ))
VM_RAM=$(title --title "Resources" --inputbox "RAM for Windows, in GB (you have ${RAM_GB} GB):" 9 60 "$DEFAULT_RAM" 3>&1 1>&2 2>&3) || { clear; exit 1; }
DEFAULT_CPU=$(( CORES >= 8 ? 4 : 2 ))
VM_CPU=$(title --title "Resources" --inputbox "CPU cores for Windows (you have ${CORES}):" 9 60 "$DEFAULT_CPU" 3>&1 1>&2 2>&3) || { clear; exit 1; }
clear

# ---- 3. Fetch WinApps and write config ---------------------------------------
echo ">> Fetching WinApps..."
mkdir -p "$(dirname "$REPO_DIR")" "$CONF_DIR"
if [[ -d "$REPO_DIR/.git" ]]; then
  git -C "$REPO_DIR" pull --ff-only
else
  git clone --depth 1 "$REPO_URL" "$REPO_DIR"
fi

[[ -f "$REPO_DIR/compose.yaml" ]] || die "WinApps' compose.yaml wasn't found; the upstream layout may have changed. Check $REPO_DIR."
cp "$REPO_DIR/compose.yaml" "$COMPOSE"

# Patch the dockur/windows environment values in place.
set_env() {  # key value
  if grep -qE "^\s*$1:" "$COMPOSE"; then
    sed -i -E "s|^(\s*$1:).*|\1 \"$2\"|" "$COMPOSE"
  else
    echo "   (note: $1 not found in compose.yaml; left at upstream default)"
  fi
}
set_env VERSION   "$WIN_VERSION"
set_env RAM_SIZE  "${VM_RAM}G"
set_env CPU_CORES "$VM_CPU"
set_env USERNAME  "$WIN_USER"
set_env PASSWORD  "$WIN_PASS"

umask 077
cat > "$CONF" <<EOF
# Generated by mydistro-winapps-setup on $(date +%F)
RDP_USER="$WIN_USER"
RDP_PASS="$WIN_PASS"
RDP_DOMAIN=""
RDP_IP="127.0.0.1"
WAFLAVOR="podman"
RDP_SCALE="100"
RDP_FLAGS="/cert:tofu /sound /microphone +home-drive"
MULTIMON="false"
DEBUG="true"
EOF
chmod 600 "$CONF" "$COMPOSE"
echo ">> Config written to $CONF"

# ---- 4. Start Windows ---------------------------------------------------------
echo ">> Starting Windows container (first run downloads and installs Windows)..."
podman-compose --file "$COMPOSE" up -d

title --title "Installing Windows" --msgbox "Windows is now downloading and installing in the background. This usually takes 20-60 minutes.\n\nA browser tab will open so you can watch. Don't close this terminal; it will continue automatically when Windows is ready." 12 66
xdg-open "$VIEWER" >/dev/null 2>&1 || true
clear

# ---- 5. Wait for RDP, then run the WinApps installer -------------------------
echo ">> Waiting for Windows to accept connections on port 3389..."
for i in $(seq 1 240); do   # up to ~2 hours
  if nc -z 127.0.0.1 3389 2>/dev/null; then
    echo ">> Windows is up."
    break
  fi
  printf '.'; sleep 30
  [[ $i -eq 240 ]] && die "Windows didn't come up in 2 hours. Check $VIEWER and run: podman logs WinApps"
done

title --title "Almost done" --msgbox "Windows is ready.\n\nInstall your Windows programs now (e.g. Adobe Creative Cloud) through the browser view at $VIEWER, then press OK.\n\nYou can also do this later and rerun the last step with:\n  $REPO_DIR/setup.sh --user" 14 70
clear

echo ">> Running the WinApps installer (adds Windows apps to your menu)..."
bash "$REPO_DIR/setup.sh" --user

notify-send -i preferences-desktop-remote-desktop "$APP" "Windows apps are now in your application menu." 2>/dev/null || true
echo ">> Finished. Windows apps now appear in your application menu."
